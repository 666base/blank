{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blank",
  "version": "0.27.0",
  "identifier": "app.blank.desktop",
  "build": {
    "beforeDevCommand": "yarn web:dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "yarn web:build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blank",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
