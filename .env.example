# Blank env template (no secrets)
# Copy to `.env` locally. Never commit `.env`.

# Supabase project "blank" — client may only use URL + anon/publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# NEVER put service_role in a VITE_ variable or ship it in Tauri/APK.
# VITE_SUPABASE_SERVICE_KEY=  # DO NOT USE IN CLIENT

# Optional: converge script / admin tooling only (local shell, not bundled)
# SUPABASE_EMAIL=
# SUPABASE_PASSWORD=

# Tauri updater signing (local only; never commit private key)
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PUBLIC_KEY=
